# =============================================================================
# .gitignore for TicketManagement project
# =============================================================================

# --- Environment / Secrets ---
.env
*.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# --- Django ---
backend/db.sqlite3
backend/staticfiles/
backend/media/
backend/*.log
backend/celerybeat-schedule

# --- Node ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/
*.swp

# --- Local runtime files ---
*.log
*.pid

